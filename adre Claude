<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
(function(){

  /* ============ THREE.JS SOFT LIGHT PARTICLES ============ */
  var container = document.getElementById('bg-canvas');
  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(50, window.innerWidth/window.innerHeight, 0.1, 100);
  camera.position.z = 6;

  var renderer = new THREE.WebGLRenderer({ antialias:true, alpha:true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  container.appendChild(renderer.domElement);

  function dotTexture(){
    var size = 128;
    var c = document.createElement('canvas'); c.width = c.height = size;
    var ctx = c.getContext('2d');
    var g = ctx.createRadialGradient(size/2,size/2,0,size/2,size/2,size/2);
    g.addColorStop(0,'rgba(255,255,255,1)');
    g.addColorStop(0.45,'rgba(255,255,255,0.55)');
    g.addColorStop(1,'rgba(255,255,255,0)');
    ctx.fillStyle = g; ctx.fillRect(0,0,size,size);
    return new THREE.CanvasTexture(c);
  }

  var COUNT = 260;
  var geo = new THREE.BufferGeometry();
  var positions = new Float32Array(COUNT*3);
  var colors = new Float32Array(COUNT*3);
  var palette = [ new THREE.Color(0x8d7cc7), new THREE.Color(0xcabfe9), new THREE.Color(0xe9e5f5) ];
  for (var i=0;i<COUNT;i++){
    positions[i*3]   = (Math.random()-0.5)*14;
    positions[i*3+1] = (Math.random()-0.5)*10;
    positions[i*3+2] = (Math.random()-0.5)*8;
    var col = palette[Math.floor(Math.random()*palette.length)];
    colors[i*3]=col.r; colors[i*3+1]=col.g; colors[i*3+2]=col.b;
  }
  geo.setAttribute('position', new THREE.BufferAttribute(positions,3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors,3));

  var mat = new THREE.PointsMaterial({
    size: 0.32, map: dotTexture(), transparent:true, opacity:0.55,
    vertexColors:true, depthWrite:false, blending:THREE.NormalBlending, sizeAttenuation:true
  });
  var particles = new THREE.Points(geo, mat);
  scene.add(particles);

  var mouseX=0, mouseY=0;
  window.addEventListener('mousemove', function(e){
    mouseX = (e.clientX/window.innerWidth)*2-1;
    mouseY = (e.clientY/window.innerHeight)*2-1;
  });

  var clock = new THREE.Clock();
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animate(){
    requestAnimationFrame(animate);
    var t = clock.getElapsedTime();
    if (!reduceMotion){
      particles.rotation.y = t*0.015;
      var pos = geo.attributes.position.array;
      for (var i=0;i<COUNT;i++){
        pos[i*3+1] += Math.sin(t*0.4 + i)*0.0006;
      }
      geo.attributes.position.needsUpdate = true;
    }
    camera.position.x += (mouseX*0.3 - camera.position.x)*0.02;
    camera.position.y += (-mouseY*0.2 - camera.position.y)*0.02;
    camera.lookAt(scene.position);
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', function(){
    camera.aspect = window.innerWidth/window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  /* ============ CURSOR DOT ============ */
  var canHover = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
  if (canHover){
    var dot = document.querySelector('.cursor-dot');
    dot.style.opacity = '0.55';
    var dx = gsap.quickTo(dot,'x',{duration:0.35, ease:'power3'});
    var dy = gsap.quickTo(dot,'y',{duration:0.35, ease:'power3'});
    window.addEventListener('mousemove', function(e){ dx(e.clientX); dy(e.clientY); });
  }

  /* ============ GSAP SCROLL ============ */
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.progress-bar', {
    scaleX: 1, ease:'none',
    scrollTrigger:{ trigger: document.documentElement, start:'top top', end:'bottom bottom', scrub:0.3 }
  });

  ScrollTrigger.create({
    trigger:'#hero', start:'bottom top',
    onEnter:function(){ document.getElementById('nav').classList.add('scrolled'); },
    onLeaveBack:function(){ document.getElementById('nav').classList.remove('scrolled'); }
  });

  var heroTl = gsap.timeline({ delay:0.15 });
  heroTl
    .to('.hero h1 .line span', { y:'0%', duration:1.1, ease:'power4.out', stagger:0.12 })
    .to('.hero .eyebrow', { opacity:1, duration:0.7 }, 0.05)
    .to('.hero-sub', { opacity:1, duration:0.8 }, '-=0.7')
    .to('.hero-actions', { opacity:1, duration:0.8 }, '-=0.6')
    .to('.hero-trust', { opacity:1, duration:0.8 }, '-=0.6')
    .fromTo('.hero-photo-wrap', { opacity:0, y:24 }, { opacity:1, y:0, duration:1, ease:'power3.out' }, '-=0.9');

  document.querySelectorAll('.reveal').forEach(function(el){
    gsap.to(el, { opacity:1, y:0, duration:1, ease:'power3.out',
      scrollTrigger:{ trigger: el, start:'top 85%' } });
  });

  gsap.utils.toArray('.service-card').forEach(function(el,i){
    gsap.fromTo(el, {opacity:0,y:22}, { opacity:1, y:0, duration:0.7, ease:'power3.out', delay:i*0.05,
      scrollTrigger:{ trigger: el, start:'top 90%' } });
  });
  gsap.utils.toArray('.review-card').forEach(function(el,i){
    gsap.fromTo(el, {opacity:0,y:22}, { opacity:1, y:0, duration:0.7, ease:'power3.out', delay:i*0.04,
      scrollTrigger:{ trigger: el, start:'top 92%' } });
  });
  gsap.utils.toArray('.gallery-item').forEach(function(el,i){
    gsap.fromTo(el, {opacity:0,y:22}, { opacity:1, y:0, duration:0.7, ease:'power3.out', delay:i*0.06,
      scrollTrigger:{ trigger: el, start:'top 90%' } });
  });

  document.querySelectorAll('.count').forEach(function(el){
    var target = parseFloat(el.getAttribute('data-target'));
    var decimals = parseInt(el.getAttribute('data-decimals')||'0');
    var obj = { val:0 };
    ScrollTrigger.create({
      trigger: el, start:'top 90%', once:true,
      onEnter:function(){
        gsap.to(obj, { val: target, duration:1.3, ease:'power2.out',
          onUpdate:function(){ el.textContent = obj.val.toFixed(decimals).replace('.',','); } });
      }
    });
  });

  var btn = document.getElementById('magnetBtn');
  if (btn && canHover){
    var bx = gsap.quickTo(btn,'x',{duration:0.5, ease:'elastic.out(1,0.4)'});
    var by = gsap.quickTo(btn,'y',{duration:0.5, ease:'elastic.out(1,0.4)'});
    btn.addEventListener('mousemove', function(e){
      var r = btn.getBoundingClientRect();
      bx((e.clientX-r.left-r.width/2)*0.3); by((e.clientY-r.top-r.height/2)*0.3);
    });
    btn.addEventListener('mouseleave', function(){ bx(0); by(0); });
  }

  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var target = document.querySelector(a.getAttribute('href'));
      if (target){
        e.preventDefault();
        var y = target.getBoundingClientRect().top + window.pageYOffset - 60;
        window.scrollTo({ top:y, behavior:'smooth' });
      }
    });
  });

  /* ============ LIGHTBOX ============ */
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightboxImg');
  document.querySelectorAll('.gallery-item').forEach(function(item){
    item.addEventListener('click', function(){
      lightboxImg.src = item.getAttribute('data-full');
      lightboxImg.alt = item.querySelector('img').alt;
      lightbox.style.visibility = 'visible';
      gsap.to(lightbox, { opacity:1, duration:0.35 });
    });
  });
  function closeLightbox(){
    gsap.to(lightbox, { opacity:0, duration:0.3, onComplete:function(){ lightbox.style.visibility='hidden'; } });
  }
  document.getElementById('lightboxClose').addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', function(e){ if (e.target === lightbox) closeLightbox(); });
  window.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeLightbox(); });

  /* ============ SLIDE-OVER PANELS ============ */
  var overlayBg = document.getElementById('overlayBg');
  var panels = { impressum: document.getElementById('panel-impressum'), datenschutz: document.getElementById('panel-datenschutz') };
  var openPanelEl = null;

  function openPanel(name){
    var p = panels[name];
    if (!p) return;
    openPanelEl = p;
    overlayBg.style.visibility = 'visible';
    gsap.to(overlayBg, { opacity:1, duration:0.3 });
    gsap.to(p, { x:'0%', duration:0.55, ease:'power3.out' });
  }
  function closePanel(){
    if (!openPanelEl) return;
    gsap.to(openPanelEl, { x:'100%', duration:0.45, ease:'power3.in' });
    gsap.to(overlayBg, { opacity:0, duration:0.3, onComplete:function(){ overlayBg.style.visibility='hidden'; } });
    openPanelEl = null;
  }
  document.querySelectorAll('[data-panel]').forEach(function(btn){
    btn.addEventListener('click', function(){ openPanel(btn.getAttribute('data-panel')); });
  });
  document.querySelectorAll('[data-close]').forEach(function(btn){ btn.addEventListener('click', closePanel); });
  overlayBg.addEventListener('click', closePanel);
  window.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePanel(); });

  /* ============ CONTACT FORM (mailto) ============ */
  var form = document.getElementById('contactForm');
  var status = document.getElementById('formStatus');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = form.name.value, email = form.email.value, msg = form.message.value;
    var subject = encodeURIComponent('Kontaktanfrage über die Website');
    var body = encodeURIComponent('Name: ' + name + '\nE-Mail: ' + email + '\n\n' + msg);
    window.location.href = 'mailto:physioardey@gmail.com?subject=' + subject + '&body=' + body;
    status.textContent = 'Ihr E-Mail-Programm öffnet sich gleich mit Ihrer Nachricht.';
  });

})();
</script>
